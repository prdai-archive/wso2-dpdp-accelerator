# Copy to .env after Terraform has created the VMs. Never commit .env.
IS_VM_IP=192.0.2.10
DB_VM_IP=192.0.2.11
SSH_USER=ubuntu
SSH_KEY=~/.ssh/id_ed25519

# Use the DNS name users will open in their browser. Until DNS exists, use the
# IS VM address and add the same value to the operator machine's hosts file.
IS_HOSTNAME=dpdp.example.com
IS_ADMIN_USERNAME=admin
IS_ADMIN_PASSWORD=change-me

DB_APP_USER=wso2carbon
DB_APP_PASSWORD=change-me

# Optional defaults:
# DB_PORT=3306
# IS_VERSION=7.3.0
# IS_HOME=/opt/wso2/wso2is-7.3.0
# MYSQL_CONNECTOR_VERSION=8.3.0
# IDENTITY_DB=WSO2IDENTITY_DB
# SHARED_DB=WSO2SHARED_DB
# AGENT_DB=WSO2AGENTIDENTITY_DB
# DPDP_DB=WSO2DPDP_DB
