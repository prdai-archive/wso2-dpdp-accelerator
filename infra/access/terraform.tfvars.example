# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
#
# Getting the bootstrap kubeconfig: download it from the Harvester UI
# (Support -> Download Kubeconfig, or the Rancher UI -> Harvester cluster ->
# Kubeconfig File) and put it somewhere outside this repo, e.g.
# ~/.kube/harvester-bootstrap.yaml.
#
# The API server address is Harvester's own Kubernetes API on port 6443 - NOT the
# Rancher proxy URL. Ask the platform team if you don't have it.

harvester_bootstrap_kubeconfig = "~/.kube/harvester-bootstrap.yaml" # REPLACE
harvester_api_server           = "https://YOUR-HARVESTER-API:6443"  # REPLACE
vm_namespace                   = "YOUR-TENANT-NAMESPACE"            # REPLACE

# consumer_name defaults to "dpdp"; only set it if this namespace already has a
# "dpdp" consumer from something else.
# consumer_name = "dpdp"
