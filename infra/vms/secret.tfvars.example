# Copy to secret.tfvars and fill in. secret.tfvars is git-ignored - never commit it.
#
# Optional. Leave vm_password out entirely (or commented) to allow key-only SSH -
# that is the default and the recommended setting. Set it only if you want a
# console/password fallback for reaching the VMs when your key is not to hand.

# vm_password = "change-me"
