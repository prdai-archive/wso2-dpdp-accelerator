# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

# Path to the kubeconfig from ../access. Only change this if you keep it
# somewhere other than the repo-root kube-config/ directory.
# harvester_kubeconfig_path = "../../kube-config/harvester.yaml"

# prefix = "dpdp"   # VM names become <prefix>-is and <prefix>-db

# Ask the platform team for these three - they are tenant-specific and there is
# no sensible default. The values below are from the OpenHealthCare demos tenant
# and are shown only to illustrate the expected shape.
vm_namespace = "solutions-rnd-oh-demos"                             # REPLACE
vm_image     = "images/ubuntu-24-04"                                # REPLACE
vm_network   = "solutions-rnd-oh-demos-common/vm-subnet-730"        # REPLACE

# vm_user = "ubuntu"

# This path adds the operator's key. List every collaborator's public key in
# ssh_authorized_keys before the first apply so each person uses their own key.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_authorized_keys = [
  # "ssh-ed25519 AAAA... colleague-one",
  # "ssh-ed25519 AAAA... colleague-two",
]
