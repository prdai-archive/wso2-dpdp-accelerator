# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

# Platform-scoped Harvester kubeconfig. This file is a credential; keep it
# outside the repository and do not commit it.
harvester_kubeconfig_path = "~/.kube/config" # REPLACE

# prefix = "dpdp"   # VM names become <prefix>-is and <prefix>-db

vm_namespace = "solutions-rnd-dpdp-demos"
vm_image     = "images/ubuntu-24-04"
vm_network   = "solutions-rnd-dpdp-demos-common/vm-subnet-733"

# vm_user = "ubuntu"

# Add every collaborator's public key directly. Never add a private key.
ssh_authorized_keys = [
  # "ssh-ed25519 AAAA... collaborator-one",
  # "ssh-ed25519 AAAA... collaborator-two",
]
